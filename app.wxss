page {
  background: #f4f0e3;
  color: #161616;
  font-family: "Bahnschrift", "DIN Alternate", -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  letter-spacing: 0.2rpx;
}

view, text, button, input, textarea, scroll-view, picker {
  box-sizing: border-box;
}

.page {
  padding: 24rpx 28rpx 56rpx;
}

.with-nav {
  padding-bottom: 190rpx;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.wrap {
  display: flex;
  flex-wrap: wrap;
}

.muted {
  color: #736b58;
}

.small {
  font-size: 24rpx;
}

.tiny {
  font-size: 22rpx;
}

.bold {
  font-weight: 700;
}

.text-blue {
  color: #8c6500;
}

.text-green {
  color: #216b4c;
}

.text-red {
  color: #b33a32;
}

.text-amber {
  color: #8c6500;
}

.center {
  text-align: center;
}

.right {
  text-align: right;
}

.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-28 { margin-top: 28rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-28 { margin-bottom: 28rpx; }

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero {
  position: relative;
  overflow: hidden;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  padding: 36rpx 34rpx;
  color: #ffffff;
  background: #141414;
  box-shadow: 8rpx 8rpx 0 #f5c400;
}

.hero::after {
  content: "";
  position: absolute;
  width: 180rpx;
  height: 340rpx;
  right: -112rpx;
  top: -120rpx;
  border-radius: 0;
  transform: rotate(24deg);
  background: #f5c400;
}

.hero::before {
  content: "";
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  right: 30rpx;
  bottom: -76rpx;
  border-radius: 0;
  transform: rotate(45deg);
  background: rgba(245, 196, 0, 0.24);
}

.hero-title {
  position: relative;
  z-index: 1;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: 1rpx;
}

.hero-sub {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.76);
}

.hero-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 28rpx;
}

.hero-number {
  color: #f5c400;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.hero-tag {
  position: relative;
  z-index: 1;
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 2rpx;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #111111;
  background: #f5c400;
}

.card {
  background: #fffdf7;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 6rpx 6rpx 0 #e2d8c0;
}

.card-flat {
  background: #fffdf7;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  padding: 24rpx;
}

.card-soft {
  background: #fff7d6;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  padding: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 0 16rpx;
  padding-left: 14rpx;
  border-left: 8rpx solid #f5c400;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}

.section-title .more {
  font-size: 24rpx;
  font-weight: 400;
  color: #736b58;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.stat {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  padding: 24rpx 22rpx;
  background: #fffdf7;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  box-shadow: 5rpx 5rpx 0 #e2d8c0;
}

.stat-3 {
  width: calc(33.333% - 16rpx);
}

.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.15;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #736b58;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 5rpx 12rpx;
  border: 1rpx solid transparent;
  border-radius: 2rpx;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}

.pill-blue {
  color: #111111;
  background: #f5c400;
  border-color: #111111;
}

.pill-green {
  color: #216b4c;
  background: #e7f2e9;
  border-color: #7fa58f;
}

.pill-amber {
  color: #6f5700;
  background: #fff1bf;
  border-color: #8c6500;
}

.pill-gray {
  color: #6b6452;
  background: #efe8d8;
  border-color: #b5aa91;
}

.pill-red {
  color: #b33a32;
  background: #f7e5e1;
  border-color: #cf8a84;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 30rpx;
  margin: 0;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.5rpx;
  color: #161616;
  background: #fffdf7;
}

.btn::after {
  border: none;
}

.btn-primary {
  color: #111111;
  background: #f5c400;
  border-color: #161616;
  box-shadow: 5rpx 5rpx 0 #161616;
}

.btn-green {
  color: #ffffff;
  background: #216b4c;
  border-color: #161616;
  box-shadow: 5rpx 5rpx 0 #161616;
}

.btn-danger {
  color: #b33a32;
  background: #fffdf7;
  border-color: #b33a32;
}

.btn-ghost {
  color: #161616;
  background: #fffdf7;
  border: 2rpx solid #161616;
}

.btn-soft {
  color: #161616;
  background: #fff1b8;
  border-color: #161616;
}

.btn-sm {
  height: 64rpx;
  padding: 0 22rpx;
  border-width: 1rpx;
  border-radius: 2rpx;
  font-size: 24rpx;
  box-shadow: none;
}

.btn-block {
  display: flex;
  width: 100%;
}

.btn[disabled] {
  opacity: 0.55;
}

.btn-row {
  display: flex;
  margin-top: 20rpx;
}

.btn-row .btn {
  flex: 1;
}

.btn-row .btn + .btn {
  margin-left: 16rpx;
}

.paper-card {
  position: relative;
  background: #fffdf7;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  padding: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 6rpx 6rpx 0 #e2d8c0;
}

.paper-name {
  max-width: 78%;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.paper-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #736b58;
}

.paper-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e7dec8;
}

.paper-time {
  font-size: 22rpx;
  color: #8a8069;
}

.paper-status {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
}

.score-inline {
  font-size: 30rpx;
  font-weight: 800;
  color: #8c6500;
}

.score-inline small {
  font-size: 22rpx;
  font-weight: 400;
  color: #736b58;
}

.progress {
  height: 12rpx;
  border: 1rpx solid #161616;
  border-radius: 0;
  background: #e7dec8;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: 0;
  background: #f5c400;
}

.empty {
  padding: 70rpx 24rpx;
  text-align: center;
  color: #8a8069;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 18rpx;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 800;
  color: #111111;
  background: #f5c400;
  box-shadow: 4rpx 4rpx 0 #e2d8c0;
}

.empty-icon.green {
  color: #216b4c;
  background: #e7f2e9;
}

.loading {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #8a8069;
}

.divider {
  height: 1rpx;
  background: #e7dec8;
  margin: 22rpx 0;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.chip {
  margin: 6rpx;
  padding: 12rpx 20rpx;
  border-radius: 2rpx;
  font-size: 23rpx;
  color: #5f5948;
  background: #fffdf7;
  border: 2rpx solid #161616;
}

.chip.active {
  color: #111111;
  background: #f5c400;
  border-color: #161616;
  font-weight: 800;
}

.tab-row {
  white-space: nowrap;
  margin: 0 -28rpx 20rpx;
  padding: 0 28rpx;
}

.tab-item {
  display: inline-block;
  margin-right: 24rpx;
  padding: 12rpx 2rpx 14rpx;
  font-size: 27rpx;
  color: #736b58;
  border-bottom: 4rpx solid transparent;
}

.tab-item.active {
  color: #161616;
  font-weight: 800;
  border-bottom-color: #f5c400;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e7dec8;
}

.list-item:last-child {
  border-bottom: none;
}

.avatar {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #111111;
  background: #f5c400;
}

.avatar-green {
  color: #ffffff;
  background: #216b4c;
}

.avatar-amber {
  color: #111111;
  background: #f5c400;
}

.form-card {
  background: #fffdf7;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  padding: 28rpx;
  box-shadow: 6rpx 6rpx 0 #e2d8c0;
}

.form-item {
  margin-bottom: 26rpx;
}

.form-label {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #5f5948;
}

.field {
  width: 100%;
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 2rpx;
  font-size: 28rpx;
  color: #161616;
  background: #fffdf7;
  border: 2rpx solid #161616;
}

.field-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx 22rpx;
  border-radius: 2rpx;
  font-size: 28rpx;
  color: #161616;
  background: #fffdf7;
  border: 2rpx solid #161616;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 2rpx;
  font-size: 28rpx;
  color: #161616;
  background: #fffdf7;
  border: 2rpx solid #161616;
}

.search-box {
  display: flex;
  align-items: center;
  height: 78rpx;
  padding: 0 22rpx;
  margin-bottom: 20rpx;
  border-radius: 2rpx;
  background: #fffdf7;
  border: 2rpx solid #161616;
}

.search-icon {
  margin-right: 12rpx;
  color: #8a8069;
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
}

.count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 34rpx;
  color: #111111;
  background: #f5c400;
}

.stepper-input {
  width: 92rpx;
  height: 64rpx;
  margin: 0 12rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #161616;
  background: #fffdf7;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
}

.modal-mask {
  position: fixed;
  z-index: 90;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(10, 10, 10, 0.55);
}

.modal {
  position: fixed;
  z-index: 91;
  left: 28rpx;
  right: 28rpx;
  top: 50%;
  max-height: 76vh;
  overflow-y: auto;
  padding: 32rpx;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  background: #fffdf7;
  box-shadow: 8rpx 8rpx 0 #f5c400;
  transform: translateY(-50%);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
}

.modal-close {
  padding: 8rpx 12rpx;
  color: #8a8069;
  font-size: 32rpx;
}

.answer-option {
  display: flex;
  align-items: flex-start;
  padding: 22rpx;
  margin-bottom: 16rpx;
  border-radius: 2rpx;
  background: #fffdf7;
  border: 2rpx solid #d8ceb5;
}

.answer-option.selected {
  background: #fff1b8;
  border-color: #161616;
}

.answer-option.correct {
  background: #e7f2e9;
  border-color: #7fa58f;
}

.answer-option.wrong {
  background: #f7e5e1;
  border-color: #cf8a84;
}

.option-key {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border-radius: 2rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #5f5948;
  background: #ffffff;
  border: 2rpx solid #161616;
}

.answer-option.selected .option-key {
  color: #111111;
  background: #f5c400;
  border-color: #161616;
}

.answer-option.correct .option-key {
  color: #ffffff;
  background: #216b4c;
  border-color: #216b4c;
}

.answer-option.wrong .option-key {
  color: #ffffff;
  background: #b33a32;
  border-color: #b33a32;
}

.option-text {
  flex: 1;
  padding-top: 3rpx;
  font-size: 27rpx;
  color: #2a2a26;
}

.code-text {
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 24rpx;
}

.exam-header {
  padding: 26rpx 28rpx;
  color: #ffffff;
  background: #141414;
  border-bottom: 4rpx solid #f5c400;
}

.exam-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.exam-title {
  max-width: 72%;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
}

.exam-timer {
  padding: 8rpx 16rpx;
  border: 2rpx solid #111111;
  border-radius: 2rpx;
  font-size: 25rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: #111111;
  background: #f5c400;
}

.exam-timer.danger {
  color: #ffffff;
  background: #b33a32;
  border-color: #ffffff;
}

.exam-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.exam-progress {
  height: 8rpx;
  margin-top: 20rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.16);
  overflow: hidden;
}

.exam-progress-inner {
  height: 100%;
  border-radius: 4rpx;
  background: #f5c400;
}

.question-card {
  padding: 30rpx;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  background: #fffdf7;
  box-shadow: 6rpx 6rpx 0 #e2d8c0;
}

.question-index {
  font-size: 23rpx;
  font-weight: 700;
  color: #8c6500;
}

.question-stem {
  margin: 18rpx 0 24rpx;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.6;
}

.question-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a8069;
}

.exam-footer {
  position: fixed;
  z-index: 30;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fffdf7;
  border-top: 2rpx solid #161616;
  box-shadow: 0 -4rpx 0 #e2d8c0;
}

.exam-footer .btn {
  flex: 1;
}

.exam-footer .btn + .btn {
  margin-left: 12rpx;
}

.exam-body {
  padding: 24rpx 28rpx 190rpx;
}

.q-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.q-cell {
  width: calc(16.666% - 12rpx);
  height: 68rpx;
  margin: 6rpx;
  border: 1rpx solid #c9bea4;
  border-radius: 2rpx;
  line-height: 66rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #6b6452;
  background: #fffdf7;
}

.q-cell.answered {
  color: #111111;
  background: #fff1b8;
  border-color: #8c6500;
}

.q-cell.current {
  color: #111111;
  background: #f5c400;
  border-color: #161616;
  font-weight: 800;
}

.result-hero {
  position: relative;
  overflow: hidden;
  padding: 38rpx 32rpx;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  color: #ffffff;
  background: #141414;
  box-shadow: 8rpx 8rpx 0 #f5c400;
  text-align: center;
}

.result-hero::after {
  content: "";
  position: absolute;
  width: 160rpx;
  height: 300rpx;
  right: -110rpx;
  top: -130rpx;
  transform: rotate(24deg);
  background: #f5c400;
}

.result-score {
  position: relative;
  z-index: 1;
  color: #f5c400;
  font-size: 92rpx;
  font-weight: 800;
  line-height: 1;
}

.result-score-total {
  position: relative;
  z-index: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.72);
}

.result-label {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.76);
}

.result-badge {
  position: relative;
  z-index: 1;
  display: inline-block;
  margin-top: 16rpx;
  padding: 7rpx 20rpx;
  border: 2rpx solid #111111;
  border-radius: 2rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #111111;
  background: #f5c400;
}

.kp-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e7dec8;
}

.kp-row:last-child {
  border-bottom: none;
}

.kp-name {
  width: 230rpx;
  font-size: 24rpx;
  color: #38352c;
}

.kp-bar {
  flex: 1;
  margin: 0 18rpx;
}

.kp-rate {
  width: 92rpx;
  text-align: right;
  font-size: 23rpx;
  font-weight: 700;
}

.review-card {
  padding: 26rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid #161616;
  border-left: 8rpx solid #f5c400;
  border-radius: 2rpx;
  background: #fffdf7;
  box-shadow: 5rpx 5rpx 0 #e2d8c0;
}

.review-card.wrong {
  border-left-color: #b33a32;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-stem {
  margin-top: 14rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.55;
}

.analysis {
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #d8ceb5;
  border-radius: 2rpx;
  font-size: 24rpx;
  color: #5f5948;
  background: #faf6ea;
}

.analysis-label {
  font-weight: 700;
  color: #2a2a26;
}

.popup {
  position: fixed;
  z-index: 92;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 82vh;
  overflow-y: auto;
  padding: 30rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  border: 2rpx solid #161616;
  border-radius: 0;
  background: #fffdf7;
  box-shadow: 0 -8rpx 0 #f5c400;
}

.popup-title {
  font-size: 31rpx;
  font-weight: 700;
}

.hint-box {
  padding: 20rpx 22rpx;
  border: 2rpx solid #161616;
  border-left: 8rpx solid #f5c400;
  border-radius: 2rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #38352c;
  background: #fff1bf;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.quick-item {
  width: calc(25% - 16rpx);
  margin: 8rpx;
  padding: 20rpx 8rpx;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  text-align: center;
  background: #fffdf7;
  box-shadow: 4rpx 4rpx 0 #e2d8c0;
}

.quick-icon {
  width: 60rpx;
  height: 60rpx;
  margin: 0 auto 10rpx;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
  color: #111111;
  background: #f5c400;
}

.quick-label {
  font-size: 22rpx;
  color: #38352c;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e7dec8;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 25rpx;
  color: #736b58;
}

.info-value {
  font-size: 26rpx;
  color: #161616;
  font-weight: 500;
}

.notice {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid #8c6500;
  border-radius: 2rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6f5700;
  background: #fff1bf;
}

.exam-top-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.link-text {
  color: #6b6452;
  font-size: 24rpx;
}

.footer-space {
  height: 20rpx;
}
