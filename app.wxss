page {
  background: #f3f6fb;
  color: #17233d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}

view, text, button, input, textarea, scroll-view, picker {
  box-sizing: border-box;
}

.page {
  padding: 24rpx 28rpx 56rpx;
}

.with-nav {
  padding-bottom: 190rpx;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.wrap {
  display: flex;
  flex-wrap: wrap;
}

.muted {
  color: #7b8aa6;
}

.small {
  font-size: 24rpx;
}

.tiny {
  font-size: 22rpx;
}

.bold {
  font-weight: 700;
}

.text-blue {
  color: #2f6fed;
}

.text-green {
  color: #0f9f6e;
}

.text-red {
  color: #e5484d;
}

.text-amber {
  color: #d97706;
}

.center {
  text-align: center;
}

.right {
  text-align: right;
}

.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-28 { margin-top: 28rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-28 { margin-bottom: 28rpx; }

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero {
  position: relative;
  overflow: hidden;
  border-radius: 34rpx;
  padding: 36rpx 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0a2854 0%, #1858a8 62%, #0b7f83 100%);
  box-shadow: 0 18rpx 40rpx rgba(16, 54, 105, 0.18);
}

.hero::after {
  content: "";
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  right: -90rpx;
  top: -110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.09);
}

.hero::before {
  content: "";
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  right: 60rpx;
  bottom: -110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.hero-title {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-sub {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.76);
}

.hero-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 28rpx;
}

.hero-number {
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.hero-tag {
  position: relative;
  z-index: 1;
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 26rpx rgba(25, 50, 90, 0.055);
}

.card-flat {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
}

.card-soft {
  background: #f7faff;
  border: 1rpx solid #e5eefb;
  border-radius: 24rpx;
  padding: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 4rpx 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.section-title .more {
  font-size: 24rpx;
  font-weight: 400;
  color: #7b8aa6;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.stat {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  padding: 24rpx 22rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 22rpx rgba(25, 50, 90, 0.05);
}

.stat-3 {
  width: calc(33.333% - 16rpx);
}

.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.15;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7b8aa6;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
  white-space: nowrap;
}

.pill-blue {
  color: #215bd1;
  background: #eaf1ff;
}

.pill-green {
  color: #087a58;
  background: #e5f8f0;
}

.pill-amber {
  color: #a65c00;
  background: #fff4df;
}

.pill-gray {
  color: #68758e;
  background: #eef1f6;
}

.pill-red {
  color: #c32d33;
  background: #ffecec;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 30rpx;
  margin: 0;
  border: none;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  color: #28518c;
  background: #eef4ff;
}

.btn::after {
  border: none;
}

.btn-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #2f6fed, #1857b8);
  box-shadow: 0 12rpx 24rpx rgba(47, 111, 237, 0.24);
}

.btn-green {
  color: #ffffff;
  background: linear-gradient(135deg, #10a778, #087a58);
  box-shadow: 0 12rpx 24rpx rgba(16, 167, 120, 0.2);
}

.btn-danger {
  color: #c32d33;
  background: #ffecec;
}

.btn-ghost {
  color: #28518c;
  background: #ffffff;
  border: 1rpx solid #dce6f5;
}

.btn-soft {
  color: #215bd1;
  background: #eaf1ff;
}

.btn-sm {
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
}

.btn-block {
  display: flex;
  width: 100%;
}

.btn[disabled] {
  opacity: 0.55;
}

.btn-row {
  display: flex;
  margin-top: 20rpx;
}

.btn-row .btn {
  flex: 1;
}

.btn-row .btn + .btn {
  margin-left: 16rpx;
}

.paper-card {
  position: relative;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 26rpx rgba(25, 50, 90, 0.055);
}

.paper-name {
  max-width: 78%;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.paper-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7b8aa6;
}

.paper-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf1f7;
}

.paper-time {
  font-size: 22rpx;
  color: #8b97ad;
}

.paper-status {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
}

.score-inline {
  font-size: 30rpx;
  font-weight: 800;
  color: #215bd1;
}

.score-inline small {
  font-size: 22rpx;
  font-weight: 400;
  color: #7b8aa6;
}

.progress {
  height: 10rpx;
  border-radius: 999rpx;
  background: #edf1f7;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2f6fed, #0ea5a4);
}

.empty {
  padding: 70rpx 24rpx;
  text-align: center;
  color: #8b97ad;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 18rpx;
  border-radius: 50%;
  line-height: 92rpx;
  text-align: center;
  font-size: 36rpx;
  color: #6d8fc7;
  background: #eaf1ff;
}

.empty-icon.green {
  color: #087a58;
  background: #e5f8f0;
}

.loading {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #8b97ad;
}

.divider {
  height: 1rpx;
  background: #edf1f7;
  margin: 22rpx 0;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.chip {
  margin: 6rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #56637b;
  background: #f1f4f9;
  border: 1rpx solid transparent;
}

.chip.active {
  color: #215bd1;
  background: #eaf1ff;
  border-color: #bcd2ff;
  font-weight: 600;
}

.tab-row {
  white-space: nowrap;
  margin: 0 -28rpx 20rpx;
  padding: 0 28rpx;
}

.tab-item {
  display: inline-block;
  margin-right: 24rpx;
  padding: 12rpx 2rpx 14rpx;
  font-size: 27rpx;
  color: #7b8aa6;
  border-bottom: 4rpx solid transparent;
}

.tab-item.active {
  color: #1e57c4;
  font-weight: 700;
  border-bottom-color: #2f6fed;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.list-item:last-child {
  border-bottom: none;
}

.avatar {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #215bd1;
  background: #eaf1ff;
}

.avatar-green {
  color: #087a58;
  background: #e5f8f0;
}

.avatar-amber {
  color: #a65c00;
  background: #fff4df;
}

.form-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
}

.form-item {
  margin-bottom: 26rpx;
}

.form-label {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #56637b;
}

.field {
  width: 100%;
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #17233d;
  background: #f5f8fd;
  border: 1rpx solid #e5edf8;
}

.field-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #17233d;
  background: #f5f8fd;
  border: 1rpx solid #e5edf8;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #17233d;
  background: #f5f8fd;
  border: 1rpx solid #e5edf8;
}

.search-box {
  display: flex;
  align-items: center;
  height: 78rpx;
  padding: 0 22rpx;
  margin-bottom: 20rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #e5edf8;
}

.search-icon {
  margin-right: 12rpx;
  color: #8b97ad;
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
}

.count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 34rpx;
  color: #28518c;
  background: #eef4ff;
}

.stepper-input {
  width: 92rpx;
  height: 64rpx;
  margin: 0 12rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #17233d;
  background: #f5f8fd;
  border-radius: 16rpx;
}

.modal-mask {
  position: fixed;
  z-index: 90;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(10, 24, 48, 0.45);
}

.modal {
  position: fixed;
  z-index: 91;
  left: 28rpx;
  right: 28rpx;
  top: 50%;
  max-height: 76vh;
  overflow-y: auto;
  padding: 32rpx;
  border-radius: 30rpx;
  background: #ffffff;
  transform: translateY(-50%);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
}

.modal-close {
  padding: 8rpx 12rpx;
  color: #8b97ad;
  font-size: 32rpx;
}

.answer-option {
  display: flex;
  align-items: flex-start;
  padding: 22rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: #f7f9fd;
  border: 2rpx solid transparent;
}

.answer-option.selected {
  background: #eef5ff;
  border-color: #7aa7ff;
}

.answer-option.correct {
  background: #ebfaf4;
  border-color: #74d6b6;
}

.answer-option.wrong {
  background: #fff0f0;
  border-color: #f5a3a6;
}

.option-key {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  line-height: 46rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #5a6b87;
  background: #ffffff;
  border: 1rpx solid #dce6f5;
}

.answer-option.selected .option-key {
  color: #ffffff;
  background: #2f6fed;
  border-color: #2f6fed;
}

.answer-option.correct .option-key {
  color: #ffffff;
  background: #0f9f6e;
  border-color: #0f9f6e;
}

.answer-option.wrong .option-key {
  color: #ffffff;
  background: #e5484d;
  border-color: #e5484d;
}

.option-text {
  flex: 1;
  padding-top: 3rpx;
  font-size: 27rpx;
  color: #2d3b53;
}

.code-text {
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 24rpx;
}

.exam-header {
  padding: 26rpx 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0a2854, #1858a8 70%, #0b7f83);
}

.exam-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.exam-title {
  max-width: 72%;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
}

.exam-timer {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
}

.exam-timer.danger {
  background: #e5484d;
}

.exam-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.exam-progress {
  height: 8rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  overflow: hidden;
}

.exam-progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: #68e0c4;
}

.question-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(25, 50, 90, 0.055);
}

.question-index {
  font-size: 23rpx;
  font-weight: 700;
  color: #2f6fed;
}

.question-stem {
  margin: 18rpx 0 24rpx;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.6;
}

.question-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8b97ad;
}

.exam-footer {
  position: fixed;
  z-index: 30;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid #e8eef8;
  box-shadow: 0 -10rpx 30rpx rgba(25, 50, 90, 0.06);
}

.exam-footer .btn {
  flex: 1;
}

.exam-footer .btn + .btn {
  margin-left: 12rpx;
}

.exam-body {
  padding: 24rpx 28rpx 190rpx;
}

.q-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.q-cell {
  width: calc(16.666% - 12rpx);
  height: 68rpx;
  margin: 6rpx;
  border-radius: 16rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #68758e;
  background: #f2f5fa;
}

.q-cell.answered {
  color: #215bd1;
  background: #eaf1ff;
}

.q-cell.current {
  color: #ffffff;
  background: #2f6fed;
}

.result-hero {
  padding: 38rpx 32rpx;
  border-radius: 32rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0a2854, #1a5cae 60%, #0b7f83);
  text-align: center;
}

.result-score {
  font-size: 84rpx;
  font-weight: 800;
  line-height: 1;
}

.result-score-total {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.72);
}

.result-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.76);
}

.result-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 7rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.17);
}

.kp-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.kp-row:last-child {
  border-bottom: none;
}

.kp-name {
  width: 230rpx;
  font-size: 24rpx;
  color: #3d4b63;
}

.kp-bar {
  flex: 1;
  margin: 0 18rpx;
}

.kp-rate {
  width: 92rpx;
  text-align: right;
  font-size: 23rpx;
  font-weight: 700;
}

.review-card {
  padding: 26rpx;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border-left: 6rpx solid #10a778;
  box-shadow: 0 6rpx 20rpx rgba(25, 50, 90, 0.045);
}

.review-card.wrong {
  border-left-color: #e5484d;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-stem {
  margin-top: 14rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.55;
}

.analysis {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  color: #56637b;
  background: #f7f9fd;
}

.analysis-label {
  font-weight: 700;
  color: #2d3b53;
}

.popup {
  position: fixed;
  z-index: 92;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 82vh;
  overflow-y: auto;
  padding: 30rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 50rpx rgba(10, 24, 48, 0.18);
}

.popup-title {
  font-size: 31rpx;
  font-weight: 700;
}

.hint-box {
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #56637b;
  background: #f7f9fd;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.quick-item {
  width: calc(25% - 16rpx);
  margin: 8rpx;
  padding: 20rpx 8rpx;
  border-radius: 22rpx;
  text-align: center;
  background: #f7f9fd;
}

.quick-icon {
  width: 60rpx;
  height: 60rpx;
  margin: 0 auto 10rpx;
  border-radius: 18rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #215bd1;
  background: #eaf1ff;
}

.quick-label {
  font-size: 22rpx;
  color: #3d4b63;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.info-row:last-child {
  border-bottom: none;
}

