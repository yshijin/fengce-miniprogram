.boot-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #111111;
  color: #ffffff;
}

.boot-page::after {
  content: "";
  position: absolute;
  width: 460rpx;
  height: 460rpx;
  right: -260rpx;
  top: -180rpx;
  transform: rotate(26deg);
  background: #f5c400;
}

.boot-mark {
  position: relative;
  z-index: 1;
  width: 116rpx;
  height: 116rpx;
  border: 2rpx solid #f5c400;
  border-radius: 0;
  line-height: 112rpx;
  text-align: center;
  font-size: 56rpx;
  font-weight: 900;
  color: #111111;
  background: #f5c400;
  box-shadow: 6rpx 6rpx 0 rgba(255, 255, 255, 0.2);
}

.boot-text {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.76);
}
