.page-title {
  padding-left: 14rpx;
  border-left: 8rpx solid #f5c400;
  font-size: 36rpx;
  font-weight: 800;
  color: #161616;
}

.page-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8069;
}

.student-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  background: #fffdf7;
  box-shadow: 5rpx 5rpx 0 #e2d8c0;
}

.student-name {
  font-size: 29rpx;
  font-weight: 700;
}

.student-meta {
  margin-top: 3rpx;
  font-size: 21rpx;
  color: #736b58;
}

.student-stats {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #8a8069;
}

.student-stats text {
  margin-right: 18rpx;
}
