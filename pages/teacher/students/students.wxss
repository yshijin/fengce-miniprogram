.page-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #17233d;
}

.page-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8b97ad;
}

.student-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(25, 50, 90, 0.055);
}

.student-name {
  font-size: 29rpx;
  font-weight: 700;
}

.student-meta {
  margin-top: 3rpx;
  font-size: 21rpx;
  color: #7b8aa6;
}

.student-stats {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #8b97ad;
}

.student-stats text {
  margin-right: 18rpx;
}
