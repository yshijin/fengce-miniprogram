.teacher-progress {
  flex: 1;
  margin-right: 20rpx;
}

.paper-action {
  flex: none;
  padding: 8rpx 16rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  font-size: 23rpx;
  font-weight: 800;
  color: #111111;
  background: #f5c400;
}

.log-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e7dec8;
}

.log-row:last-child {
  border-bottom: none;
}

.log-dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  margin: 12rpx 16rpx 0 0;
  border-radius: 0;
  background: #f5c400;
}

.log-detail {
  font-size: 24rpx;
  line-height: 1.55;
  color: #38352c;
}

.log-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8a8069;
}
