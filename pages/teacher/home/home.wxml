<view class="page with-nav" wx:if="{{user}}">
  <class-switcher classes="{{classes}}" current="{{currentClassId}}" bind:change="onClassChange"></class-switcher>

  <view class="hero">
    <view class="hero-tag">{{courseName}} · 教师工作台</view>
    <view class="hero-title">{{user.name}}，{{currentClassName}}</view>
    <view class="hero-sub">班级数据按当前教学班实时筛选，可在上方切换教学班。</view>
    <view class="hero-row">
      <view>
        <view class="hero-number">{{stats.studentCount}}</view>
        <view class="hero-label">班级学生</view>
      </view>
      <view>
        <view class="hero-number">{{stats.paperCount}}</view>
        <view class="hero-label">测评数量</view>
      </view>
      <view>
        <view class="hero-number">{{stats.participation}}<text style="font-size:24rpx">%</text></view>
        <view class="hero-label">学生参与率</view>
      </view>
    </view>
  </view>

  <view class="stat-grid mt-20">
    <view class="stat">
      <view class="stat-value text-blue">{{stats.submittedCount}}</view>
      <view class="stat-label">累计交卷</view>
    </view>
    <view class="stat">
      <view class="stat-value">{{stats.avg}}<text style="font-size:24rpx">%</text></view>
      <view class="stat-label">平均得分率</view>
    </view>
    <view class="stat">
      <view class="stat-value text-amber">{{stats.pendingStudents}}</view>
      <view class="stat-label">未完成学生</view>
    </view>
    <view class="stat">
      <view class="stat-value text-green">{{stats.paperCount ? '正常' : '—'}}</view>
      <view class="stat-label">教学班状态</view>
    </view>
  </view>

  <view class="section-title">
    <text>快捷操作</text>
  </view>
  <view class="quick-grid">
    <view class="quick-item" bindtap="goStudents">
      <view class="quick-icon">生</view>
      <view class="quick-label">学生管理</view>
    </view>
    <view class="quick-item" bindtap="goPapers">
      <view class="quick-icon">卷</view>
      <view class="quick-label">试卷管理</view>
    </view>
    <view class="quick-item" bindtap="goCreate">
      <view class="quick-icon">+</view>
      <view class="quick-label">创建测试</view>
    </view>
    <view class="quick-item" bindtap="goData">
      <view class="quick-icon">数</view>
      <view class="quick-label">数据统计</view>
    </view>
  </view>

  <view class="section-title">
    <text>最近测评</text>
    <text class="more" bindtap="goPapers">全部 ›</text>
  </view>

  <view class="empty" wx:if="{{error}}">
    <view class="empty-icon">!</view>
    <view>{{error}}</view>
    <button class="btn btn-soft btn-sm mt-20" bindtap="reload">重新加载</button>
  </view>
  <view class="loading" wx:elif="{{loading}}">正在加载工作台…</view>

  <block wx:else>
    <view class="paper-card"
          wx:for="{{recentPapers}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="openPaper">
      <view class="paper-status">
        <text class="pill pill-{{item.statusTone}}">{{item.statusLabel}}</text>
      </view>
      <view class="paper-name">{{item.name}}</view>
      <view class="paper-meta">{{item.questionCount}} 题 · 满分 {{item.total}} · {{item.timeText}}</view>
      <view class="paper-bottom">
        <view class="teacher-progress">
          <view class="progress">
            <view class="progress-inner" style="width: {{item.completion}}%"></view>
          </view>
          <view class="small muted mt-8">已交卷 {{item.submitted}} / {{item.expected}} · {{item.completion}}%</view>
        </view>
        <view class="paper-action">查看数据</view>
      </view>
    </view>

    <view class="empty" wx:if="{{!recentPapers.length}}">
      <view class="empty-icon">卷</view>
      <view>当前教学班还没有测评</view>
      <button class="btn btn-primary btn-sm mt-20" bindtap="goCreate">创建第一场测试</button>
    </view>

    <view class="section-title" wx:if="{{logs.length}}">
      <text>最近动态</text>
    </view>
    <view class="card" wx:if="{{logs.length}}">
      <view class="log-row" wx:for="{{logs}}" wx:key="id">
        <view class="log-dot"></view>
        <view class="flex-1">
          <view class="log-detail">{{item.detail}}</view>
          <view class="log-meta">{{item.action}} · {{item.timeText}}</view>
        </view>
      </view>
    </view>
  </block>
</view>

<view class="loading" wx:else>正在加载…</view>
<bottom-nav role="teacher" active="/pages/teacher/home/home"></bottom-nav>
