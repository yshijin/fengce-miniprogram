.page-title {
  padding-left: 14rpx;
  border-left: 8rpx solid #f5c400;
  font-size: 36rpx;
  font-weight: 800;
  color: #161616;
}

.page-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8069;
}

.paper-data {
  padding: 18rpx 0 4rpx;
  border-top: 1rpx solid #e7dec8;
}

.paper-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.paper-actions .btn + .btn {
  margin-left: 12rpx;
}
