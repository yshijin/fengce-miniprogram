.page-title {
  padding-left: 14rpx;
  border-left: 8rpx solid #f5c400;
  font-size: 36rpx;
  font-weight: 800;
  color: #161616;
}

.page-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8069;
}

.overview-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e7dec8;
}

.overview-row:last-child {
  border-bottom: none;
}

.overview-name {
  font-size: 26rpx;
  font-weight: 700;
}

.overview-right {
  width: 116rpx;
  text-align: right;
}

.overview-value {
  font-size: 27rpx;
  font-weight: 800;
  color: #8c6500;
}

.paper-data {
  padding-top: 14rpx;
  border-top: 1rpx solid #e7dec8;
}

.paper-action-row {
  margin-top: 16rpx;
  text-align: right;
  font-size: 22rpx;
  font-weight: 800;
  color: #8c6500;
}

.report-row {
  display: flex;
  align-items: center;
  padding: 22rpx;
  margin-bottom: 14rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  background: #fffdf7;
  box-shadow: 5rpx 5rpx 0 #e2d8c0;
}

.report-name {
  font-size: 27rpx;
  font-weight: 700;
}

.report-meta {
  margin-top: 3rpx;
  font-size: 20rpx;
  color: #8a8069;
}

.score-strong {
  margin-right: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #8c6500;
}

.history-arrow {
  flex: none;
  margin-left: 10rpx;
  font-size: 36rpx;
  color: #c9bea4;
}
