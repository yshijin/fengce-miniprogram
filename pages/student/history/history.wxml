<view class="page with-nav">
  <view class="hero" wx:if="{{user}}">
    <view class="hero-tag">{{user.name}} · 学习档案</view>
    <view class="hero-title">评测记录</view>
    <view class="hero-sub">每一次评测都会留下知识点掌握轨迹。</view>
    <view class="hero-row">
      <view>
        <view class="hero-number">{{stats.count}}</view>
        <view class="hero-label">已完成评测</view>
      </view>
      <view>
        <view class="hero-number">{{stats.avg}}<text style="font-size:24rpx">%</text></view>
        <view class="hero-label">平均得分率</view>
      </view>
      <view>
        <view class="hero-number">{{stats.best}}<text style="font-size:24rpx">%</text></view>
        <view class="hero-label">最佳得分率</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{error}}">
    <view class="empty-icon">!</view>
    <view>{{error}}</view>
    <button class="btn btn-soft btn-sm mt-20" bindtap="reload">重新加载</button>
  </view>
  <view class="loading" wx:elif="{{loading}}">正在加载成绩…</view>

  <block wx:else>
    <view class="section-title">
      <text>成绩记录</text>
      <text class="more">{{attempts.length}} 次</text>
    </view>

    <view class="history-card"
          wx:for="{{attempts}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="openResult">
      <view class="history-score history-{{item.tone}}">
        <view class="history-score-value">{{item.score}}</view>
        <view class="history-score-total">/ {{item.total}}</view>
      </view>
      <view class="flex-1">
        <view class="history-name">{{item.paperName}}</view>
        <view class="history-meta">{{item.paperClass}} · {{item.submittedText}}</view>
        <view class="row mt-8">
          <text class="pill pill-{{item.tone}}">{{item.grade}}</text>
          <text class="small muted" style="margin-left: 12rpx">得分率 {{item.rate}}% · 用时 {{item.timeUsed}} 分钟</text>
        </view>
      </view>
      <view class="history-arrow">›</view>
    </view>

    <view class="empty" wx:if="{{!attempts.length}}">
      <view class="empty-icon">绩</view>
      <view>还没有已完成的评测</view>
      <view class="small muted mt-8">完成一次评测后，成绩会保存在这里</view>
      <button class="btn btn-primary btn-sm mt-20" bindtap="goHome">去完成评测</button>
    </view>
  </block>
</view>

<bottom-nav role="student" active="/pages/student/history/history"></bottom-nav>
