.history-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  background: #fffdf7;
  box-shadow: 5rpx 5rpx 0 #e2d8c0;
}

.history-score {
  flex: none;
  width: 110rpx;
  height: 110rpx;
  margin-right: 22rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  text-align: center;
  color: #111111;
  background: #f5c400;
}

.history-score-value {
  padding-top: 14rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
}

.history-score-total {
  font-size: 20rpx;
  color: #736b58;
}

.history-amber {
  color: #111111;
  background: #f5c400;
}

.history-red {
  color: #b33a32;
  background: #f7e5e1;
}

.history-green {
  color: #ffffff;
  background: #216b4c;
}

.history-name {
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
}

.history-meta {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8a8069;
}

.history-arrow {
  flex: none;
  margin-left: 12rpx;
  font-size: 38rpx;
  color: #c9bea4;
}
