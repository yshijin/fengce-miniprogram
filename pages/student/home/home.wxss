.student-links {
  display: flex;
  margin: 20rpx -8rpx 4rpx;
}

.student-link {
  display: flex;
  align-items: center;
  flex: 1;
  margin: 0 8rpx;
  padding: 20rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  background: #fffdf7;
  box-shadow: 5rpx 5rpx 0 #e2d8c0;
}

.student-link-icon {
  flex: none;
  width: 62rpx;
  height: 62rpx;
  margin-right: 14rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  line-height: 58rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 800;
  color: #111111;
  background: #f5c400;
}

.student-link-icon.green {
  color: #ffffff;
  background: #216b4c;
}

.student-link-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #1d1d1d;
}

.student-link-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #8a8069;
}

.paper-action {
  margin-left: 16rpx;
  padding: 8rpx 16rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  font-size: 23rpx;
  font-weight: 800;
  color: #111111;
  background: #f5c400;
}

.paper-action.muted {
  color: #736b58;
  background: #f2ecde;
  border-color: #b5aa91;
}
