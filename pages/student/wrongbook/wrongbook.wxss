.select-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  background: #fffdf7;
  box-shadow: 5rpx 5rpx 0 #e2d8c0;
}

.select-bar > view:first-child {
  flex: none;
  min-width: 150rpx;
}

.select-bar .row {
  flex: none;
}

.select-bar .row .btn {
  flex: none;
  width: auto;
  min-width: 0;
  padding: 0 20rpx;
}

.select-bar .row .btn + .btn {
  margin-left: 10rpx;
}

.select-count {
  font-size: 27rpx;
  font-weight: 800;
  color: #1d1d1d;
}

.wrong-card {
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  background: #fffdf7;
  box-shadow: 5rpx 5rpx 0 #e2d8c0;
}

.wrong-head {
  display: flex;
  align-items: flex-start;
}

.select-dot {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin: 2rpx 18rpx 0 0;
  border-radius: 0;
  line-height: 38rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
  color: transparent;
  background: #fffdf7;
  border: 2rpx solid #161616;
}

.select-dot.active {
  color: #111111;
  background: #f5c400;
  border-color: #161616;
}

.wrong-stem {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.55;
}

.wrong-meta {
  margin: 14rpx 0 0 62rpx;
  font-size: 21rpx;
  color: #8a8069;
}

.wrong-detail {
  margin-left: 62rpx;
}

.answer-summary {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #d8ceb5;
  border-radius: 0;
  color: #5f5948;
  background: #faf6ea;
}
