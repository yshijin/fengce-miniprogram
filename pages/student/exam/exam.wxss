.exam-top-link {
  padding: 8rpx 16rpx;
  border: 2rpx solid #f5c400;
  border-radius: 0;
  font-size: 23rpx;
  font-weight: 800;
  color: #111111;
  background: #f5c400;
}

.exam-progress-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.62);
}

.exam-question-actions {
  display: flex;
  margin-top: 24rpx;
}

.exam-question-actions .btn {
  flex: 1;
}

.exam-question-actions .btn + .btn {
  margin-left: 16rpx;
}

.save-state {
  margin-top: 20rpx;
  text-align: center;
  font-size: 21rpx;
  color: #8a8069;
}
