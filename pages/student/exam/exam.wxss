.exam-top-link {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.13);
}

.exam-progress-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.62);
}

.exam-question-actions {
  display: flex;
  margin-top: 24rpx;
}

.exam-question-actions .btn {
  flex: 1;
}

.exam-question-actions .btn + .btn {
  margin-left: 16rpx;
}

.save-state {
  margin-top: 20rpx;
  text-align: center;
  font-size: 21rpx;
  color: #8b97ad;
}
