.profile-hero {
  display: flex;
  align-items: center;
  padding: 34rpx 30rpx;
  border-radius: 32rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0a2854, #1858a8 62%, #0b7f83);
  box-shadow: 0 18rpx 40rpx rgba(16, 54, 105, 0.18);
}

.profile-avatar {
  flex: none;
  width: 104rpx;
  height: 104rpx;
  margin-right: 22rpx;
  border-radius: 32rpx;
  line-height: 104rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.profile-name {
  font-size: 36rpx;
  font-weight: 800;
}

.profile-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.76);
}

.profile-tag {
  display: inline-block;
  margin-top: 12rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.82);
  background: rgba(255, 255, 255, 0.14);
}

.menu-card {
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(25, 50, 90, 0.055);
  overflow: hidden;
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid #edf1f7;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  flex: none;
  width: 62rpx;
  height: 62rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  line-height: 62rpx;
  text-align: center;
  font-size: 23rpx;
  font-weight: 700;
  color: #215bd1;
  background: #eaf1ff;
}

.menu-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #26344d;
}

.menu-sub {
  margin-top: 3rpx;
  font-size: 20rpx;
  color: #8b97ad;
}

.menu-arrow {
  flex: none;
  margin-left: 12rpx;
  font-size: 36rpx;
  color: #c2cbd9;
}

.mine-footer {
  margin-top: 30rpx;
  text-align: center;
  font-size: 20rpx;
  color: #9aa6ba;
}
