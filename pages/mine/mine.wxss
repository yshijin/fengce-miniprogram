.profile-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  padding: 34rpx 30rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  color: #ffffff;
  background: #141414;
  box-shadow: 8rpx 8rpx 0 #f5c400;
}

.profile-hero::after {
  content: "";
  position: absolute;
  width: 150rpx;
  height: 300rpx;
  right: -100rpx;
  top: -110rpx;
  transform: rotate(24deg);
  background: #f5c400;
}

.profile-avatar {
  position: relative;
  z-index: 1;
  flex: none;
  width: 104rpx;
  height: 104rpx;
  margin-right: 22rpx;
  border: 2rpx solid #f5c400;
  border-radius: 0;
  line-height: 100rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 900;
  color: #111111;
  background: #f5c400;
}

.profile-name {
  position: relative;
  z-index: 1;
  font-size: 36rpx;
  font-weight: 800;
}

.profile-sub {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.76);
}

.profile-tag {
  position: relative;
  z-index: 1;
  display: inline-block;
  margin-top: 12rpx;
  padding: 5rpx 12rpx;
  border: 2rpx solid #111111;
  border-radius: 0;
  font-size: 20rpx;
  font-weight: 800;
  color: #111111;
  background: #f5c400;
}

.menu-card {
  border: 2rpx solid #161616;
  border-radius: 0;
  background: #fffdf7;
  box-shadow: 6rpx 6rpx 0 #e2d8c0;
  overflow: hidden;
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid #e7dec8;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  flex: none;
  width: 62rpx;
  height: 62rpx;
  margin-right: 18rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  line-height: 58rpx;
  text-align: center;
  font-size: 23rpx;
  font-weight: 800;
  color: #111111;
  background: #f5c400;
}

.menu-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #1d1d1d;
}

.menu-sub {
  margin-top: 3rpx;
  font-size: 20rpx;
  color: #8a8069;
}

.menu-arrow {
  flex: none;
  margin-left: 12rpx;
  font-size: 36rpx;
  color: #161616;
}

.mine-footer {
  margin-top: 30rpx;
  text-align: center;
  font-size: 20rpx;
  color: #9b927c;
}
