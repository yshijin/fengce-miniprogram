.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding: calc(env(safe-area-inset-top) + 92rpx) 44rpx calc(36rpx + env(safe-area-inset-bottom));
  background: #111111;
}

.login-orb {
  position: absolute;
  border-radius: 0;
  background: #f5c400;
}

.login-orb-a {
  width: 460rpx;
  height: 460rpx;
  right: -240rpx;
  top: -160rpx;
  transform: rotate(26deg);
}

.login-orb-b {
  width: 280rpx;
  height: 280rpx;
  left: -170rpx;
  bottom: 70rpx;
  transform: rotate(45deg);
  background: transparent;
  border: 2rpx solid rgba(245, 196, 0, 0.45);
}

.brand {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #ffffff;
}

.brand-mark {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 20rpx;
  border: 2rpx solid #f5c400;
  border-radius: 0;
  line-height: 108rpx;
  text-align: center;
  font-size: 60rpx;
  font-weight: 900;
  color: #111111;
  background: #f5c400;
  box-shadow: 6rpx 6rpx 0 rgba(255, 255, 255, 0.2);
}

.brand-title {
  display: inline-block;
  padding-bottom: 4rpx;
  border-bottom: 6rpx solid #f5c400;
  font-size: 58rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
}

.brand-sub {
  margin-top: 12rpx;
  font-size: 23rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.68);
}

.login-card {
  position: relative;
  z-index: 1;
  margin-top: 52rpx;
  padding: 36rpx 30rpx 30rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  background: #fffdf7;
  box-shadow: 10rpx 10rpx 0 #f5c400;
}

.login-head {
  padding-left: 14rpx;
  border-left: 8rpx solid #f5c400;
  font-size: 34rpx;
  font-weight: 800;
  color: #161616;
}

.login-desc {
  margin: 8rpx 0 28rpx;
  padding-left: 14rpx;
  font-size: 22rpx;
  color: #8a8069;
}

.login-field {
  margin-bottom: 20rpx;
  padding: 16rpx 22rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  background: #fffdf7;
}

.login-field-label {
  font-size: 20rpx;
  color: #8a8069;
}

.login-input {
  height: 48rpx;
  margin-top: 4rpx;
  font-size: 29rpx;
  color: #161616;
}

.login-placeholder {
  color: #b5aa91;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 10rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  line-height: 84rpx;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #111111;
  background: #f5c400;
  box-shadow: 6rpx 6rpx 0 #161616;
}

.login-btn::after {
  border: none;
}

.quick-title {
  margin: 30rpx 0 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #736b58;
}

.quick-row {
  display: flex;
  margin: 0 -5rpx;
}

.quick-account {
  flex: 1;
  margin: 0 5rpx;
  padding: 14rpx 8rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  text-align: center;
  background: #fffdf7;
}

.quick-role {
  font-size: 21rpx;
  color: #111111;
  font-weight: 800;
}

.quick-user {
  margin-top: 3rpx;
  font-size: 21rpx;
  color: #736b58;
}

.login-tip {
  margin-top: 24rpx;
  padding: 16rpx 18rpx;
  border: 2rpx solid #161616;
  border-left: 8rpx solid #f5c400;
  border-radius: 0;
  font-size: 21rpx;
  line-height: 1.6;
  color: #38352c;
  background: #fff1bf;
}

.login-footer {
  position: relative;
  z-index: 1;
  margin-top: 34rpx;
  text-align: center;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.5);
}
