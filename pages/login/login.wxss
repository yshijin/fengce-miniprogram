.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding: calc(env(safe-area-inset-top) + 92rpx) 44rpx calc(36rpx + env(safe-area-inset-bottom));
  background: linear-gradient(160deg, #081f42 0%, #123f7c 46%, #0b7f83 100%);
}

.login-orb {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
}

.login-orb-a {
  width: 420rpx;
  height: 420rpx;
  right: -170rpx;
  top: -120rpx;
}

.login-orb-b {
  width: 300rpx;
  height: 300rpx;
  left: -130rpx;
  bottom: 140rpx;
  background: rgba(104, 224, 196, 0.08);
}

.brand {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #ffffff;
}

.brand-mark {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 20rpx;
  border-radius: 34rpx;
  line-height: 112rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.brand-title {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.brand-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.68);
}

.login-card {
  position: relative;
  z-index: 1;
  margin-top: 52rpx;
  padding: 36rpx 30rpx 30rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 30rpx 60rpx rgba(3, 18, 40, 0.24);
}

.login-head {
  font-size: 34rpx;
  font-weight: 800;
  color: #17233d;
}

.login-desc {
  margin: 6rpx 0 28rpx;
  font-size: 22rpx;
  color: #8b97ad;
}

.login-field {
  margin-bottom: 20rpx;
  padding: 16rpx 22rpx;
  border-radius: 22rpx;
  background: #f5f8fd;
  border: 1rpx solid #e5edf8;
}

.login-field-label {
  font-size: 20rpx;
  color: #8b97ad;
}

.login-input {
  height: 48rpx;
  margin-top: 4rpx;
  font-size: 29rpx;
  color: #17233d;
}

.login-placeholder {
  color: #b0bbcc;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 10rpx;
  border: none;
  border-radius: 22rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #2f6fed, #1857b8);
  box-shadow: 0 14rpx 28rpx rgba(47, 111, 237, 0.25);
}

.login-btn::after {
  border: none;
}

.quick-title {
  margin: 30rpx 0 14rpx;
  font-size: 22rpx;
  color: #7b8aa6;
}

.quick-row {
  display: flex;
  margin: 0 -5rpx;
}

.quick-account {
  flex: 1;
  margin: 0 5rpx;
  padding: 14rpx 8rpx;
  border-radius: 18rpx;
  text-align: center;
  background: #f5f8fd;
  border: 1rpx solid #e5edf8;
}

.quick-role {
  font-size: 21rpx;
  color: #2f6fed;
  font-weight: 600;
}

.quick-user {
  margin-top: 3rpx;
  font-size: 21rpx;
  color: #7b8aa6;
}

.login-tip {
  margin-top: 24rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #6f7f99;
  background: #f7f9fd;
}

.login-footer {
  position: relative;
  z-index: 1;
  margin-top: 34rpx;
  text-align: center;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.5);
}
