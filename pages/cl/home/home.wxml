<view class="page with-nav" wx:if="{{user}}">
  <view class="hero">
    <view class="hero-tag">课程运行控制台</view>
    <view class="hero-title">{{user.name}}，教学运行概览</view>
    <view class="hero-sub">管理课程、教师、教学班、学员与评测任务，实时掌握教学运行状态。</view>
    <view class="hero-row">
      <view>
        <view class="hero-number">{{overview.courses}}</view>
        <view class="hero-label">课程</view>
      </view>
      <view>
        <view class="hero-number">{{overview.classes}}</view>
        <view class="hero-label">教学班</view>
      </view>
      <view>
        <view class="hero-number">{{overview.students}}</view>
        <view class="hero-label">学生</view>
      </view>
      <view>
        <view class="hero-number">{{overview.teachers}}</view>
        <view class="hero-label">教师</view>
      </view>
    </view>
  </view>

  <view class="stat-grid mt-20">
    <view class="stat stat-3">
      <view class="stat-value text-blue">{{overview.papers}}</view>
      <view class="stat-label">评测任务</view>
    </view>
    <view class="stat stat-3">
      <view class="stat-value text-green">{{overview.students}}</view>
      <view class="stat-label">在册学生</view>
    </view>
    <view class="stat stat-3">
      <view class="stat-value">{{overview.teachers}}</view>
      <view class="stat-label">任课教师</view>
    </view>
  </view>

  <view class="quick-grid mt-20">
    <view class="quick-card" data-url="/pages/cl/manage/manage" bindtap="goPage">
      <view class="quick-icon">组</view>
      <view class="quick-name">组织管理</view>
      <view class="quick-desc">课程 · 班级 · 教师 · 学员</view>
    </view>
    <view class="quick-card" data-url="/pages/cl/papers/papers" bindtap="goPage">
      <view class="quick-icon">评</view>
      <view class="quick-name">评测任务</view>
      <view class="quick-desc">发布 · 跟踪 · 分析 · 归档</view>
    </view>
    <view class="quick-card" data-url="/pages/cl/bank/bank" bindtap="goPage">
      <view class="quick-icon">题</view>
      <view class="quick-name">题库管理</view>
      <view class="quick-desc">知识点 · 题目 · 难度</view>
    </view>
  </view>

  <scroll-view class="tab-row" scroll-x="{{true}}">
    <view class="tab-item {{activeTab === 'overview' ? 'active' : ''}}" data-tab="overview" bindtap="setTab">课程概览</view>
    <view class="tab-item {{activeTab === 'classes' ? 'active' : ''}}" data-tab="classes" bindtap="setTab">教学班</view>
    <view class="tab-item {{activeTab === 'teachers' ? 'active' : ''}}" data-tab="teachers" bindtap="setTab">教师</view>
  </scroll-view>

  <view class="empty" wx:if="{{error}}">
    <view class="empty-icon">!</view>
    <view>{{error}}</view>
    <button class="btn btn-soft btn-sm mt-20" bindtap="reload">重新加载</button>
  </view>
  <view class="loading" wx:elif="{{loading}}">正在加载课程数据…</view>

  <block wx:else>
    <block wx:if="{{activeTab === 'overview'}}">
      <view class="section-title">
        <text>课程列表</text>
        <text class="more">{{courses.length}} 门</text>
      </view>
      <view class="course-card" wx:for="{{courses}}" wx:key="id">
        <view class="course-icon">{{item.initial}}</view>
        <view class="flex-1">
          <view class="row-between">
            <view class="course-name">{{item.name}}</view>
            <text class="pill pill-green">{{item.statusLabel}}</text>
          </view>
          <view class="course-meta">{{item.code}} · {{item.term}}</view>
          <view class="course-meta">负责人 {{item.owner}} · {{item.classCount}} 个教学班</view>
        </view>
      </view>

      <view class="section-title">
        <text>教学班运行情况</text>
        <text class="more">按真实作答统计</text>
      </view>
      <view class="card">
        <view class="cl-class-row" wx:for="{{classes}}" wx:key="id">
          <view class="flex-1">
            <view class="cl-class-name">{{item.name}}</view>
            <view class="small muted mt-8">{{item.teacherName}} · {{item.studentCount}} 人 · {{item.paperCount}} 份评测</view>
          </view>
          <view class="cl-class-stat">
            <view class="cl-class-value">{{item.participation}}%</view>
            <view class="tiny muted">参与率</view>
          </view>
          <view class="cl-class-stat">
            <view class="cl-class-value">{{item.avg}}%</view>
            <view class="tiny muted">均分率</view>
          </view>
        </view>
      </view>

      <view class="section-title">
        <text>最近操作</text>
        <text class="more">{{logs.length}} 条</text>
      </view>
      <view class="card" wx:if="{{logs.length}}">
        <view class="log-row" wx:for="{{logs}}" wx:key="id">
          <view class="log-dot"></view>
          <view class="flex-1">
            <view class="log-detail">{{item.detail}}</view>
            <view class="log-meta">{{item.operator}} · {{item.role}} · {{item.action}} · {{item.timeText}}</view>
          </view>
        </view>
      </view>
      <view class="empty" wx:else>
        <view class="empty-icon">记</view>
        <view>暂无操作记录</view>
      </view>
    </block>

    <block wx:elif="{{activeTab === 'classes'}}">
      <view class="cl-entity-card" wx:for="{{classes}}" wx:key="id">
        <view class="avatar avatar-green">{{item.initial}}</view>
        <view class="flex-1">
          <view class="row-between">
            <view class="cl-entity-name">{{item.name}}</view>
            <text class="pill pill-blue">{{item.term}}</text>
          </view>
          <view class="cl-entity-meta">任课教师 {{item.teacherName}} · {{item.major}}</view>
          <view class="cl-entity-meta">{{item.studentCount}} 名学生 · {{item.paperCount}} 份评测</view>
          <view class="cl-metrics">
            <view class="cl-metric">
              <text class="cl-metric-value">{{item.participation}}%</text>
              <text class="cl-metric-label">参与率</text>
            </view>
            <view class="cl-metric">
              <text class="cl-metric-value">{{item.avg}}%</text>
              <text class="cl-metric-label">平均得分率</text>
            </view>
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{!classes.length}}">
        <view class="empty-icon">班</view>
        <view>还没有教学班</view>
      </view>
    </block>

    <block wx:else>
      <view class="cl-entity-card" wx:for="{{teachers}}" wx:key="id">
        <view class="avatar">{{item.initial}}</view>
        <view class="flex-1">
          <view class="row-between">
            <view class="cl-entity-name">{{item.name}}</view>
            <text class="pill pill-green">{{item.statusLabel}}</text>
          </view>
          <view class="cl-entity-meta">工号 {{item.no}} · {{item.phone}}</view>
          <view class="cl-entity-meta">教学班：{{item.classes}}</view>
        </view>
      </view>
      <view class="empty" wx:if="{{!teachers.length}}">
        <view class="empty-icon">师</view>
        <view>还没有教师账号</view>
      </view>
    </block>
  </block>
</view>

<view class="loading" wx:else>正在加载…</view>
<bottom-nav role="course_leader" active="/pages/cl/home/home"></bottom-nav>
