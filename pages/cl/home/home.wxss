.course-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(25, 50, 90, 0.055);
}

.course-icon {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  margin-right: 18rpx;
  border-radius: 22rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #215bd1;
  background: #eaf1ff;
}

.course-name {
  font-size: 29rpx;
  font-weight: 700;
}

.course-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8b97ad;
}

.cl-class-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.cl-class-row:last-child {
  border-bottom: none;
}

.cl-class-name {
  font-size: 26rpx;
  font-weight: 700;
}

.cl-class-stat {
  width: 106rpx;
  text-align: right;
}

.cl-class-value {
  font-size: 27rpx;
  font-weight: 800;
  color: #215bd1;
}

.cl-entity-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(25, 50, 90, 0.055);
}

.cl-entity-name {
  font-size: 29rpx;
  font-weight: 700;
}

.cl-entity-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8b97ad;
}

.cl-metrics {
  display: flex;
  margin-top: 12rpx;
}

.cl-metric {
  display: flex;
  align-items: baseline;
  margin-right: 26rpx;
}

.cl-metric-value {
  font-size: 28rpx;
  font-weight: 800;
  color: #215bd1;
}

.cl-metric-label {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #8b97ad;
}

.log-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.log-row:last-child {
  border-bottom: none;
}

.log-dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  margin: 12rpx 16rpx 0 0;
  border-radius: 50%;
  background: #2f6fed;
}

.log-detail {
  font-size: 24rpx;
  line-height: 1.55;
  color: #3d4b63;
}

.log-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8b97ad;
}
