.quick-grid {
  display: flex;
  gap: 12rpx;
}

.quick-card {
  flex: 1;
  min-width: 0;
  padding: 18rpx 14rpx;
  border: 2rpx solid #161616;
  background: #fffdf7;
  box-shadow: 4rpx 4rpx 0 #e2d8c0;
}

.quick-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid #161616;
  background: #f5c400;
  line-height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 800;
  color: #141414;
}

.quick-name {
  font-size: 24rpx;
  font-weight: 800;
  color: #141414;
}

.quick-desc {
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 1.35;
  color: #8a8069;
}

.course-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  background: #fffdf7;
  box-shadow: 5rpx 5rpx 0 #e2d8c0;
}

.course-icon {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  margin-right: 18rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  line-height: 72rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #111111;
  background: #f5c400;
}

.course-name {
  font-size: 29rpx;
  font-weight: 700;
}

.course-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8a8069;
}

.cl-class-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e7dec8;
}

.cl-class-row:last-child {
  border-bottom: none;
}

.cl-class-name {
  font-size: 26rpx;
  font-weight: 700;
}

.cl-class-stat {
  width: 106rpx;
  text-align: right;
}

.cl-class-value {
  font-size: 27rpx;
  font-weight: 800;
  color: #8c6500;
}

.cl-entity-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #161616;
  border-radius: 0;
  background: #fffdf7;
  box-shadow: 5rpx 5rpx 0 #e2d8c0;
}

.cl-entity-name {
  font-size: 29rpx;
  font-weight: 700;
}

.cl-entity-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8a8069;
}

.cl-metrics {
  display: flex;
  margin-top: 12rpx;
}

.cl-metric {
  display: flex;
  align-items: baseline;
  margin-right: 26rpx;
}

.cl-metric-value {
  font-size: 28rpx;
  font-weight: 800;
  color: #8c6500;
}

.cl-metric-label {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #8a8069;
}

.log-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e7dec8;
}

.log-row:last-child {
  border-bottom: none;
}

.log-dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  margin: 12rpx 16rpx 0 0;
  border-radius: 0;
  background: #f5c400;
}

.log-detail {
  font-size: 24rpx;
  line-height: 1.55;
  color: #38352c;
}

.log-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8a8069;
}
