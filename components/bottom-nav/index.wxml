<view class="bottom-nav">
  <view class="nav-item {{item.url === active ? 'active' : ''}}"
        wx:for="{{items}}"
        wx:key="url"
        data-url="{{item.url}}"
        bindtap="go">
    <view class="nav-icon">{{item.icon}}</view>
    <view class="nav-label">{{item.label}}</view>
  </view>
</view>
