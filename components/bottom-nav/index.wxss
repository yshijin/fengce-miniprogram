.bottom-nav {
  position: fixed;
  z-index: 40;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 12rpx 12rpx calc(10rpx + env(safe-area-inset-bottom));
  background: #fffdf7;
  border-top: 2rpx solid #161616;
  box-shadow: 0 -4rpx 0 #e2d8c0;
}

.nav-item {
  flex: 1;
  text-align: center;
  color: #8a8069;
}

.nav-icon {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 4rpx;
  border: 1rpx solid #d8ceb5;
  border-radius: 2rpx;
  line-height: 46rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 800;
  color: #736b58;
  background: #f2ecde;
}

.nav-label {
  font-size: 20rpx;
}

.nav-item.active {
  color: #161616;
}

.nav-item.active .nav-icon {
  color: #111111;
  background: #f5c400;
  border-color: #161616;
  box-shadow: 3rpx 3rpx 0 #161616;
}

.nav-item.active .nav-label {
  font-weight: 800;
}
