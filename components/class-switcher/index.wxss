.cs-wrap {
  margin-bottom: 20rpx;
}

.cs-label {
  margin: 0 4rpx 10rpx;
  font-size: 22rpx;
  color: #736b58;
}

.cs-scroll {
  width: 100%;
  white-space: nowrap;
}

.cs-chip {
  display: inline-flex;
  align-items: center;
  margin-right: 12rpx;
  padding: 13rpx 20rpx;
  border: 2rpx solid #161616;
  border-radius: 2rpx;
  font-size: 24rpx;
  color: #5f5948;
  background: #fffdf7;
}

.cs-chip.active {
  color: #111111;
  background: #f5c400;
  border-color: #161616;
  font-weight: 800;
}

.cs-count {
  min-width: 34rpx;
  margin-left: 8rpx;
  padding: 1rpx 8rpx;
  border: 1rpx solid #d8ceb5;
  border-radius: 2rpx;
  text-align: center;
  font-size: 19rpx;
  color: #736b58;
  background: #f2ecde;
}

.cs-chip.active .cs-count {
  color: #111111;
  background: #fffdf7;
  border-color: #111111;
}
